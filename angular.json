{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "6f385e9d-241b-4f86-8df1-eaabf68edb1e"
  },
  "newProjectRoot": "projects",
  "projects": {
    "shop-core": {
      "projectType": "library",
      "root": "libs/shop-core",
      "sourceRoot": "libs/shop-core",
      "prefix": "core",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "libs/shop-core/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/shop-core/tsconfig.spec.json"
          }
        }
      }
    },
    "storefront": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "apps/storefront",
      "sourceRoot": "apps/storefront/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/storefront/src/main.ts",
            "tsConfig": "apps/storefront/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/storefront/public"
              }
            ],
            "styles": [
              "apps/storefront/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "amazon": {
              "outputPath": "dist/amazon",
              "fileReplacements": [
                {
                  "replace": "apps/storefront/src/client/client.config.ts",
                  "with": "clients/amazon/client.config.ts"
                },
                {
                  "replace": "libs/shop-core/src/lib/pages/home/home.page.ts",
                  "with": "clients/amazon/pages/home/home.page.ts"
                }
              ],
              "styles": [
                "apps/storefront/src/styles.scss",
                "clients/amazon/theme.scss"
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/storefront/public"
                },
                {
                  "glob": "**/*",
                  "input": "clients/amazon/public"
                }
              ]
            },
            "flipkart": {
              "outputPath": "dist/flipkart",
              "fileReplacements": [
                {
                  "replace": "apps/storefront/src/client/client.config.ts",
                  "with": "clients/flipkart/client.config.ts"
                },
                {
                  "replace": "libs/shop-core/src/lib/layout/header/header.component.ts",
                  "with": "clients/flipkart/layout/header/header.component.ts"
                }
              ],
              "styles": [
                "apps/storefront/src/styles.scss",
                "clients/flipkart/theme.scss"
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/storefront/public"
                },
                {
                  "glob": "**/*",
                  "input": "clients/flipkart/public"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "storefront:build:production"
            },
            "development": {
              "buildTarget": "storefront:build:development"
            },
            "amazon": {
              "buildTarget": "storefront:build:development,amazon"
            },
            "flipkart": {
              "buildTarget": "storefront:build:development,flipkart"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
